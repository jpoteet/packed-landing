---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Cleveland Rocks Music Academy" description="Music lessons, camps, and school programs that help kids find their rhythm.">

  <!-- NAV -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" style="background: rgba(26,26,26,0.97); backdrop-filter: blur(12px);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
      <a href="#hero" class="flex items-center gap-2">
        <div class="w-8 h-8 bg-[#e02020] rounded flex items-center justify-center">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M9 18V5l12-2v13M9 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm12-2c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2z"/></svg>
        </div>
        <span class="text-white font-bold text-lg tracking-tight">Cleveland <span class="text-[#e02020]">Rocks</span></span>
      </a>
      <div class="hidden md:flex items-center gap-8">
        <a href="#programs" class="text-white/60 hover:text-white text-sm font-medium transition-colors">Programs</a>
        <a href="#camps" class="text-white/60 hover:text-white text-sm font-medium transition-colors">Camps</a>
        <a href="#schools" class="text-white/60 hover:text-white text-sm font-medium transition-colors">Schools</a>
        <a href="#contact" class="text-white/60 hover:text-white text-sm font-medium transition-colors">Contact</a>
        <button id="nav-book-btn" class="bg-[#e02020] hover:bg-[#b51a1a] text-white text-sm font-bold px-5 py-2 rounded-full transition-all duration-200 hover:scale-105">Book Free Intro</button>
      </div>
      <button id="mobile-menu-btn" class="md:hidden text-white p-2">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
    <div id="mobile-menu" class="hidden md:hidden bg-[#111] border-t border-white/10 px-4 pb-4">
      <div class="flex flex-col gap-2 pt-3">
        <a href="#programs" class="mobile-nav-link text-white/70 py-2 text-sm font-medium">Programs</a>
        <a href="#camps" class="mobile-nav-link text-white/70 py-2 text-sm font-medium">Camps</a>
        <a href="#schools" class="mobile-nav-link text-white/70 py-2 text-sm font-medium">Schools</a>
        <a href="#contact" class="mobile-nav-link text-white/70 py-2 text-sm font-medium">Contact</a>
        <button class="mobile-book-btn bg-[#e02020] text-white text-sm font-bold px-4 py-3 rounded-full w-full mt-2">Book Free Intro</button>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section id="hero" class="relative min-h-screen flex items-center overflow-hidden bg-[#111]">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 15% 50%, rgba(224,32,32,0.15) 0%, transparent 55%), radial-gradient(ellipse at 85% 20%, rgba(232,160,32,0.1) 0%, transparent 45%), radial-gradient(ellipse at 60% 80%, rgba(74,111,165,0.1) 0%, transparent 40%);"></div>
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(rgba(255,255,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px); background-size: 64px 64px;"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-24 pb-16 w-full">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="text-center lg:text-left">
          <div class="inline-flex items-center gap-2 bg-[#e02020]/15 border border-[#e02020]/25 rounded-full px-4 py-1.5 mb-6">
            <div class="w-2 h-2 bg-[#e02020] rounded-full animate-pulse"></div>
            <span class="text-[#e02020] text-xs font-bold tracking-wider uppercase">Now Enrolling · Summer 2025</span>
          </div>
          <h1 class="text-white font-black leading-none mb-5" style="font-size: clamp(3rem, 7.5vw, 5.8rem); font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.025em; line-height: 0.95;">
            CLEVELAND<br/>
            <span class="text-[#e02020]">ROCKS</span><br/>
            <span style="font-size: 0.68em; color: rgba(245,244,240,0.9);">MUSIC ACADEMY</span>
          </h1>
          <p class="text-white/65 text-lg sm:text-xl leading-relaxed mb-8 max-w-lg mx-auto lg:mx-0">
            Private lessons, music camps, and school-based programs for young musicians across Greater Cleveland.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
            <a href="#programs" class="bg-[#e02020] hover:bg-[#b51a1a] text-white font-bold px-8 py-4 rounded-full text-base transition-all duration-200 hover:scale-105 hover:shadow-xl hover:shadow-[#e02020]/30 text-center">View Programs</a>
            <button id="hero-book-btn" class="bg-white/8 hover:bg-white/15 border border-white/15 text-white font-bold px-8 py-4 rounded-full text-base transition-all duration-200 hover:scale-105 text-center">Book a Free Intro</button>
          </div>
          <div class="flex gap-8 justify-center lg:justify-start mt-10 pt-8 border-t border-white/10">
            <div><div class="text-white font-black text-3xl" style="font-family:'Bebas Neue',sans-serif;">200+</div><div class="text-white/40 text-xs tracking-wider">Students</div></div>
            <div><div class="text-white font-black text-3xl" style="font-family:'Bebas Neue',sans-serif;">15+</div><div class="text-white/40 text-xs tracking-wider">Instruments</div></div>
            <div><div class="text-white font-black text-3xl" style="font-family:'Bebas Neue',sans-serif;">30+</div><div class="text-white/40 text-xs tracking-wider">Schools Served</div></div>
          </div>
        </div>

        <!-- Hero visual: instrument cards -->
        <div class="hidden lg:flex items-center justify-center relative">
          <div class="relative w-[460px] h-[460px]">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-56 h-56 bg-[#e02020]/15 rounded-full blur-3xl pointer-events-none"></div>

            <div class="instrument-card absolute top-6 left-2 bg-[#1e1e1e] border border-white/8 rounded-2xl p-5 shadow-2xl w-38" style="animation-delay:0s">
              <div class="w-11 h-11 bg-[#e02020]/20 rounded-xl flex items-center justify-center mb-3">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e02020" stroke-width="1.5" stroke-linecap="round"><path d="M11.5 12.5L15 9M9 15l-1.5 1.5M16 8l-1 1M14 3l7 7-2 2-2-2-3 3c.5 1.5.5 3-1 4.5S9 19 7.5 19.5 4 19 3 18s-.5-4 1-5.5S7 11 8.5 11.5l3-3-2-2 2-2z"/></svg>
              </div>
              <div class="text-white font-bold text-sm">Guitar</div>
              <div class="text-white/35 text-xs mt-0.5">Acoustic & Electric</div>
            </div>

            <div class="instrument-card absolute top-2 right-6 bg-[#1e1e1e] border border-white/8 rounded-2xl p-5 shadow-2xl w-38" style="animation-delay:1.1s">
              <div class="w-11 h-11 bg-[#e8a020]/20 rounded-xl flex items-center justify-center mb-3">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e8a020" stroke-width="1.5" stroke-linecap="round"><ellipse cx="12" cy="11" rx="8" ry="3"/><path d="M4 11v5c0 1.66 3.58 3 8 3s8-1.34 8-3v-5"/><path d="M16 4l2-2M8 4L6 2"/></svg>
              </div>
              <div class="text-white font-bold text-sm">Drums</div>
              <div class="text-white/35 text-xs mt-0.5">Kit & Percussion</div>
            </div>

            <div class="instrument-card absolute bottom-14 left-6 bg-[#1e1e1e] border border-white/8 rounded-2xl p-5 shadow-2xl w-38" style="animation-delay:2s">
              <div class="w-11 h-11 bg-[#4a6fa5]/25 rounded-xl flex items-center justify-center mb-3">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6b8fc4" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M6 5v6M10 5v6M14 5v6M18 5v6M8 5v4M12 5v4M16 5v4"/></svg>
              </div>
              <div class="text-white font-bold text-sm">Piano</div>
              <div class="text-white/35 text-xs mt-0.5">Keys & Theory</div>
            </div>

            <div class="instrument-card absolute bottom-6 right-2 bg-[#1e1e1e] border border-white/8 rounded-2xl p-5 shadow-2xl w-38" style="animation-delay:0.6s">
              <div class="w-11 h-11 bg-[#e02020]/20 rounded-xl flex items-center justify-center mb-3">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e02020" stroke-width="1.5" stroke-linecap="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4M8 23h8"/></svg>
              </div>
              <div class="text-white font-bold text-sm">Voice</div>
              <div class="text-white/35 text-xs mt-0.5">Singing & Performance</div>
            </div>

            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[72px] h-[72px] bg-[#e02020] rounded-full flex items-center justify-center shadow-2xl shadow-[#e02020]/50">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="white"><path d="M9 18V5l12-2v13M9 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm12-2c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2z"/></svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section id="programs" class="py-20 bg-[#f5f4f0]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <span class="text-[#e02020] font-bold text-xs tracking-widest uppercase">What We Offer</span>
        <h2 class="text-4xl sm:text-5xl font-black mt-2 mb-4" style="font-family:'Bebas Neue',sans-serif;letter-spacing:0.02em;">Our Programs</h2>
        <p class="text-[#6b6660] text-lg max-w-xl mx-auto">From one-on-one lessons to full band camps — we have a program for every young musician.</p>
      </div>

      <!-- Filter tabs -->
      <div class="flex justify-center gap-2 mb-10 flex-wrap">
        <button class="tab-btn active-tab px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-200 border" data-tab="all">All Programs</button>
        <button class="tab-btn px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-200 border" data-tab="lessons">Lessons</button>
        <button class="tab-btn px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-200 border" data-tab="camps">Camps</button>
        <button class="tab-btn px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-200 border" data-tab="schools">Schools</button>
      </div>

      <div id="programs-grid" class="grid md:grid-cols-3 gap-6">
        <!-- Private Lessons -->
        <div class="program-card bg-white rounded-3xl overflow-hidden border border-[#e0ddd6] hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300" data-category="lessons">
          <div class="h-44 relative flex items-end p-6" style="background:linear-gradient(135deg,#e02020 0%,#8b1010 100%);">
            <div class="absolute top-5 right-5 w-11 h-11 bg-white/10 rounded-xl flex items-center justify-center">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><path d="M9 18V5l12-2v13M9 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm12-2c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2z"/></svg>
            </div>
            <div>
              <span class="text-white/60 text-xs font-bold uppercase tracking-widest">Year-Round</span>
              <h3 class="text-white font-black text-2xl" style="font-family:'Bebas Neue',sans-serif;letter-spacing:0.05em;">Private Lessons</h3>
            </div>
          </div>
          <div class="p-6">
            <p class="text-[#6b6660] text-sm mb-5 leading-relaxed">One-on-one instruction tailored to your child's pace, goals, and favorite music. Weekly sessions with the same dedicated teacher.</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {["Guitar","Piano","Drums","Voice","Bass","Songwriting"].map(item => (
                <span class="bg-[#f5f4f0] text-[#3d3d3d] text-xs font-semibold px-3 py-1 rounded-full">{item}</span>
              ))}
            </div>
            <button class="schedule-btn w-full bg-[#1a1a1a] hover:bg-[#e02020] text-white text-sm font-bold py-3 rounded-2xl transition-all duration-200" data-program="lessons">View Sample Schedule →</button>
          </div>
        </div>

        <!-- Camps -->
        <div class="program-card bg-white rounded-3xl overflow-hidden border border-[#e0ddd6] hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300" data-category="camps">
          <div class="h-44 relative flex items-end p-6" style="background:linear-gradient(135deg,#e8a020 0%,#9a6010 100%);">
            <div class="absolute top-5 right-5 w-11 h-11 bg-white/10 rounded-xl flex items-center justify-center">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
            </div>
            <div>
              <span class="text-white/60 text-xs font-bold uppercase tracking-widest">Summer & Breaks</span>
              <h3 class="text-white font-black text-2xl" style="font-family:'Bebas Neue',sans-serif;letter-spacing:0.05em;">Music Camps</h3>
            </div>
          </div>
          <div class="p-6">
            <p class="text-[#6b6660] text-sm mb-5 leading-relaxed">Week-long immersive camps where kids learn songs, form real bands, rehearse every day, and perform live at the end.</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {["Summer Camps","Band Workshops","Performance Day","School Break","Rock Camp","Recording"].map(item => (
                <span class="bg-[#f5f4f0] text-[#3d3d3d] text-xs font-semibold px-3 py-1 rounded-full">{item}</span>
              ))}
            </div>
            <button class="schedule-btn w-full bg-[#1a1a1a] hover:bg-[#e8a020] text-white text-sm font-bold py-3 rounded-2xl transition-all duration-200" data-program="camps">View Sample Schedule →</button>
          </div>
        </div>

        <!-- Schools -->
        <div class="program-card bg-white rounded-3xl overflow-hidden border border-[#e0ddd6] hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300" data-category="schools">
          <div class="h-44 relative flex items-end p-6" style="background:linear-gradient(135deg,#4a6fa5 0%,#1e3d6e 100%);">
            <div class="absolute top-5 right-5 w-11 h-11 bg-white/10 rounded-xl flex items-center justify-center">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>
            <div>
              <span class="text-white/60 text-xs font-bold uppercase tracking-widest">Partnerships</span>
              <h3 class="text-white font-black text-2xl" style="font-family:'Bebas Neue',sans-serif;letter-spacing:0.05em;">School Programs</h3>
            </div>
          </div>
          <div class="p-6">
            <p class="text-[#6b6660] text-sm mb-5 leading-relaxed">After-school clubs, enrichment classes, assemblies, and year-round school partnerships that integrate into your existing schedule.</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {["After-School Clubs","Enrichment Classes","Assemblies","Year-Round","PTA Events","Custom Workshops"].map(item => (
                <span class="bg-[#f5f4f0] text-[#3d3d3d] text-xs font-semibold px-3 py-1 rounded-full">{item}</span>
              ))}
            </div>
            <button class="schedule-btn w-full bg-[#1a1a1a] hover:bg-[#4a6fa5] text-white text-sm font-bold py-3 rounded-2xl transition-all duration-200" data-program="schools">View Sample Schedule →</button>
          </div>
        </div>
      </div>

      <!-- Schedule preview panel -->
      <div id="schedule-panel" class="hidden mt-8 bg-white rounded-3xl border border-[#e0ddd6] overflow-hidden shadow-sm">
        <div class="p-6 border-b border-[#e0ddd6] flex items-center justify-between">
          <h3 id="schedule-title" class="font-black text-xl" style="font-family:'Bebas Neue',sans-serif;letter-spacing:0.03em;">Sample Schedule</h3>
          <button id="close-schedule" class="w-8 h-8 rounded-full bg-[#f5f4f0] hover:bg-[#e0ddd6] flex items-center justify-center text-sm font-bold transition-colors">✕</button>
        </div>
        <div id="schedule-content" class="p-6 overflow-x-auto"></div>
      </div>
    </div>
  </section>

  <!-- WHY PARENTS LOVE IT -->
  <section class="py-20 bg-[#1a1a1a]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-14">
        <span class="text-[#e8a020] font-bold text-xs tracking-widest uppercase">Why Families Choose Us</span>
        <h2 class="text-4xl sm:text-5xl font-black text-white mt-2" style="font-family:'Bebas Neue',sans-serif;letter-spacing:0.02em;">Why Parents Love It</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          { icon:"🎤", title:"Confidence Through Music", desc:"Kids learn to express themselves, perform in front of others, and build real self-esteem that carries into every part of life." },
          { icon:"🎸", title:"Real Performance Opportunities", desc:"Students perform at end-of-camp showcases, school events, and recitals — real stages, real audiences, real memories." },
          { icon:"🌱", title:"Beginner-Friendly Instruction", desc:"No prior experience needed. Our teachers meet students exactly where they are and make learning fun from day one." },
          { icon:"📅", title:"Flexible for Busy Families", desc:"Lessons, camps, and school programs on schedules that work for real families — mornings, afternoons, evenings, and summer." },
          { icon:"🎓", title:"Experienced Local Musicians", desc:"Our teachers are working Cleveland musicians who love teaching — mentors who understand the local music scene." },
          { icon:"🤝", title:"Community-First", desc:"We're a Cleveland organization built to serve Cleveland kids. Everything we do is rooted in this city and its musical tradition." },
        ].map(item => (
          <div class="benefit-card bg-[#242424] hover:bg-[#2d2d2d] border border-white/5 hover:border-[#e02020]/25 rounded-3xl p-7 transition-all duration-300 group">
            <div class="text-3xl mb-4">{item.icon}</div>
            <h3 class="text-white font-bold text-lg mb-2 group-hover:text-[#e02020] transition-colors duration-200">{item.title}</h3>
            <p class="text-white/45 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ROCK BAND CAMP FEATURE -->
  <section id="camps" class="py-20 bg-[#f5f4f0]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="rounded-3xl overflow-hidden relative" style="background:linear-gradient(135deg,#1a1a1a 0%,#2a1a1a 100%);">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#e02020]/8 rounded-full blur-3xl -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-72 h-72 bg-[#e8a020]/8 rounded-full blur-3xl translate-y-1/3 -translate-x-1/5 pointer-events-none"></div>

        <div class="relative grid lg:grid-cols-2">
          <div class="p-10 lg:p-14">
            <div class="inline-flex items-center gap-2 bg-[#e02020] rounded-full px-4 py-1.5 mb-6">
              <span class="text-white text-xs font-bold tracking-widest uppercase">Featured Program</span>
            </div>
            <h2 class="text-white font-black leading-none" style="font-size:clamp(3rem,6vw,5rem);font-family:'Bebas Neue',sans-serif;letter-spacing:0.02em;">ROCK</h2>
            <h2 class="text-[#e02020] font-black leading-none mb-6" style="font-size:clamp(3rem,6vw,5rem);font-family:'Bebas Neue',sans-serif;letter-spacing:0.02em;">BAND CAMP</h2>
            <p class="text-white/65 text-base leading-relaxed mb-8 max-w-md">The ultimate summer experience for young musicians. Kids form real bands, learn real songs, rehearse together, and perform live at the end of camp. It's not a recital — it's a concert.</p>

            <div class="grid grid-cols-2 gap-3 mb-8">
              {[{label:"Ages",value:"8–16"},{label:"Level",value:"Beg–Int"},{label:"Duration",value:"1 Week"},{label:"Finale",value:"Live Show"}].map(item=>(
                <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
                  <div class="text-[#e8a020] text-xs font-bold uppercase tracking-wider mb-1">{item.label}</div>
                  <div class="text-white font-black text-lg" style="font-family:'Bebas Neue',sans-serif;">{item.value}</div>
                </div>
              ))}
            </div>

            <div class="space-y-2.5 mb-8">
              {["Learn 4–6 songs in your genre of choice","Collaborate with a real band of peers","Daily rehearsals with professional coaching","End-of-week live performance for family & friends","Beginner-friendly — no prior band experience needed"].map(item=>(
                <div class="flex items-start gap-3 text-white/65 text-sm">
                  <svg class="text-[#e02020] mt-0.5 shrink-0" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </div>
              ))}
            </div>

            <button id="camp-book-btn" class="bg-[#e02020] hover:bg-[#b51a1a] text-white font-bold px-8 py-4 rounded-full transition-all duration-200 hover:scale-105 hover:shadow-xl hover:shadow-[#e02020]/30">Reserve a Spot</button>
          </div>

          <!-- Week schedule visual -->
          <div class="hidden lg:flex items-center justify-center p-10">
            <div class="bg-white/5 border border-white/10 rounded-3xl p-8 w-72">
              <div class="text-white font-bold text-sm mb-6 flex items-center gap-2">
                <div class="w-2 h-2 bg-[#e02020] rounded-full"></div>
                Sample Camp Week
              </div>
              {[
                {day:"Monday",activity:"Instrument skills & band matching",color:"#e02020"},
                {day:"Tuesday",activity:"Song selection & first rehearsal",color:"#e8a020"},
                {day:"Wednesday",activity:"Deep rehearsal + studio basics",color:"#4a6fa5"},
                {day:"Thursday",activity:"Sound check & performance prep",color:"#e8a020"},
                {day:"Friday",activity:"🎸 LIVE CONCERT PERFORMANCE",color:"#e02020"},
              ].map(item=>(
                <div class="flex items-start gap-3 mb-4">
                  <div class="w-2 h-2 rounded-full mt-1.5 shrink-0" style={`background:${item.color}`}></div>
                  <div>
