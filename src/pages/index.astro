<style>
  @keyframes float {
    0%,100% { transform:translateY(0); }
    50% { transform:translateY(-10px); }
  }
  .instrument-card {
    animation: float 4.5s ease-in-out infinite;
  }

  .tab-btn {
    background: white;
    color: #6b6660;
    border-color: #e0ddd6;
  }
  .tab-btn:hover {
    border-color: #1a1a1a;
    color: #1a1a1a;
  }
  .tab-btn.active-tab {
    background: #1a1a1a;
    color: white;
    border-color: #1a1a1a;
  }

  .program-card { will-change: transform; }

  @keyframes fadeUp {
    from { opacity:0; transform:translateY(12px); }
    to { opacity:1; transform:translateY(0); }
  }
  .fade-up {
    animation: fadeUp 0.3s ease forwards;
  }
</style>

<script>
  // Mobile menu
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuBtn?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));
  document.querySelectorAll('.mobile-nav-link, .mobile-book-btn').forEach(el =>
    el.addEventListener('click', () => mobileMenu?.classList.add('hidden'))
  );

  // Modal
  const modal = document.getElementById('booking-modal');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const closeModal = document.getElementById('close-modal');
  const bookingForm = document.getElementById('booking-form');
  const modalFormContainer = document.getElementById('modal-form-container');
  const modalSuccess = document.getElementById('modal-success');
  const modalSuccessClose = document.getElementById('modal-success-close');

  function openModal() {
    modal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeModalFn() {
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
    setTimeout(() => {
      modalFormContainer?.classList.remove('hidden');
      modalSuccess?.classList.add('hidden');
      (bookingForm as HTMLFormElement)?.reset();
    }, 250);
  }

  ['nav-book-btn','hero-book-btn','camp-book-btn','cta-book-btn'].forEach(id =>
    document.getElementById(id)?.addEventListener('click', openModal)
  );
  document.querySelectorAll('.mobile-book-btn').forEach(btn => btn.addEventListener('click', openModal));
  closeModal?.addEventListener('click', closeModalFn);
  modalBackdrop?.addEventListener('click', closeModalFn);
  modalSuccessClose?.addEventListener('click', closeModalFn);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModalFn(); });

  bookingForm?.addEventListener('submit', e => {
    e.preventDefault();
    modalFormContainer?.classList.add('hidden');
    modalSuccess?.classList.remove('hidden');
  });

  // Program tab filter
  const tabBtns = document.querySelectorAll('.tab-btn');
  const programCards = document.querySelectorAll('.program-card');
  const schedulePanel = document.getElementById('schedule-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active-tab'));
      btn.classList.add('active-tab');

      const tab = btn.getAttribute('data-tab');
      schedulePanel?.classList.add('hidden');

      programCards.forEach(card => {
        const el = card as HTMLElement;
        const cat = card.getAttribute('data-category');
        if (tab === 'all' || cat === tab) {
          el.style.display = '';
          el.classList.add('fade-up');
          el.addEventListener('animationend', () => el.classList.remove('fade-up'), { once: true });
        } else {
          el.style.display = 'none';
        }
      });
    });
  });

  // Schedule preview
  type ScheduleKey = 'lessons' | 'camps' | 'schools';
  const schedules: Record<ScheduleKey, { title: string; color: string; rows: { time: string; detail: string }[] }> = {
    lessons: {
      title: "Sample Private Lesson Schedule",
      color: "#e02020",
      rows: [
        { time: "Mon 3:00 PM", detail: "30-min Guitar (Beginner) — Emma, age 9" },
        { time: "Mon 4:00 PM", detail: "45-min Piano (Intermediate) — Marcus, age 13" },
        { time: "Wed 3:30 PM", detail: "30-min Voice (Beginner) — Sofia, age 11" },
        { time: "Wed 5:00 PM", detail: "60-min Drums (Advanced) — Theo, age 15" },
        { time: "Sat 10:00 AM", detail: "30-min Bass (Beginner) — Lily, age 10" },
        { time: "Sat 11:00 AM", detail: "45-min Songwriting — Group session (4 students)" },
      ]
    },
    camps: {
      title: "Sample Summer Camp Day",
      color: "#e8a020",
      rows: [
        { time: "9:00 AM", detail: "Arrival, warm-up jams, instrument skill work" },
        { time: "10:00 AM", detail: "Band formation & song selection workshop" },
        { time: "11:30 AM", detail: "Group rehearsal with coach feedback" },
        { time: "12:30 PM", detail: "Lunch break + open jam session" },
        { time: "1:30 PM", detail: "Genre deep-dive (rock, pop, R&B, or original)" },
        { time: "3:00 PM", detail: "Band performance prep + recording preview" },
        { time: "Fri 4 PM", detail: "🎸 Live Performance Showcase for families" },
      ]
    },
    schools: {
      title: "Sample School Program Schedule",
      color: "#4a6fa5",
      rows: [
        { time: "Mon 3:15 PM", detail: "Guitar Club — 45 min (8–12 students)" },
        { time: "Wed 3:15 PM", detail: "Drum & Rhythm Enrichment — 45 min" },
        { time: "Fri 3:15 PM", detail: "Songwriting & Music Theory Club" },
        { time: "Monthly", detail: "Full-school music assembly (45–60 min)" },
        { time: "Quarterly", detail: "Student Showcase performance event" },
        { time: "On Request", detail: "PTA event, workshop, or school fair performance" },
      ]
    }
  };

  const scheduleTitle = document.getElementById('schedule-title');
  const scheduleContent = document.getElementById('schedule-content');
  const closeSchedule = document.getElementById('close-schedule');

  document.querySelectorAll('.schedule-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const program = btn.getAttribute('data-program') as ScheduleKey;
      const data = schedules[program];
      if (!data || !scheduleTitle || !scheduleContent || !schedulePanel) return;

      scheduleTitle.textContent = data.title;
      scheduleContent.innerHTML = `
        <table class="w-full text-sm min-w-[400px]">
          <thead>
            <tr class="border-b border-[#e0ddd6]">
              <th class="text-left font-bold text-[#6b6660] pb-3 pr-6 w-40 whitespace-nowrap">Time / Day</th>
              <th class="text-left font-bold text-[#6b6660] pb-3">Program Detail</th>
            </tr>
          </thead>
          <tbody>
            ${data.rows.map(row => `
              <tr class="border-b border-[#f5f4f0] hover:bg-[#fafaf8] transition-colors">
                <td class="py-3 pr-6 font-semibold text-xs whitespace-nowrap" style="color:${data.color}">${row.time}</td>
                <td class="py-3 text-[#3d3d3d]">${row.detail}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;

      schedulePanel.classList.remove('hidden');
      schedulePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });

  closeSchedule?.addEventListener('click', () => schedulePanel?.classList.add('hidden'));
</script>
